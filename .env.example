+# This is a template — copy it to ".env" and fill in your own real values.
# ".env" is git-ignored and never committed; this file (".env.example") is the
# only one that gets pushed to GitHub, so it must never contain real credentials.

# ---- Database: DynamoDB (used by database/ and server/) ----
AWS_REGION=us-east-1
# Local development points at DynamoDB Local (docker compose up -d dynamodb).
# LEAVE THIS UNSET in production so the SDK talks to real DynamoDB using the
# instance/task role or your shared AWS profile.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_PORT=8000
DYNAMODB_ADMIN_PORT=8001
# DynamoDB table names are global per account+region, so everything is namespaced.
DYNAMODB_TABLE_PREFIX=eventmgmt_
# PAY_PER_REQUEST (default) or PROVISIONED — only read by `npm run db:migrate`.
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST

# Credentials. DynamoDB Local accepts any non-empty pair; against real AWS,
# prefer an IAM role and leave these unset entirely.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# ---- Admin login (single account, personal use only) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
# Generate your own with: openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=30d

# ---- Email (stub transport by default) ----
EMAIL_TRANSPORT=console
EMAIL_FROM=noreply@example.com
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# ---- Client (Vite, must be prefixed VITE_) ----
VITE_API_URL=http://localhost:4000/api/v1

# ---- One-time migration only ----
# Set this to the OLD Postgres database when running
# `npm run db:import-postgres` to copy existing rows into DynamoDB.
# Nothing else in the app reads it.
# DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name
